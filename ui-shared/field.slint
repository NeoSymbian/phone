// The text field Contacts and Messages share (moved from Contacts' parts).
import { Theme } from "@neoui/theme.slint";
import { KeyboardFocus } from "@neoui/components/keyboard/focus.slint";
import { Glyph } from "common.slint";

// A field as the mockups draw it: optional search glyph, placeholder, the system keyboard on focus, a clear button.
// Typed text is the user's, in any keyboard language (DejaVu Sans).
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> search;
    in property <bool> clearable;
    // the system keyboard it brings up (neoui ipc KEYBOARD: 1 letters, 3 number pad, 4 phone pad)
    in property <int> keys: 1;
    // KeyboardFocus.seq when this field took the focus (a later field's focus wins over this one letting go)
    property <int> took;
    callback edited(string);
    height: 44 * Theme.dp;
    border-radius: 10 * Theme.dp;
    background: Theme.field;
    border-width: max(1px, Theme.dp / 2);
    border-color: input.has-focus ? Theme.accent : #ffffff0f;
    if input.has-focus: Rectangle {
        x: -3 * Theme.dp;
        y: -3 * Theme.dp;
        width: parent.width + 6 * Theme.dp;
        height: parent.height + 6 * Theme.dp;
        border-radius: 13 * Theme.dp;
        border-width: 3 * Theme.dp;
        border-color: Theme.accent.with-alpha(0.2);
    }
    function reopen() {
        KeyboardFocus.seq += 1;
        root.took = KeyboardFocus.seq;
        KeyboardFocus.dismissed = false;
    }
    HorizontalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: (clearable && root.text != "") ? 4 * Theme.dp : 12 * Theme.dp;
        spacing: 8 * Theme.dp;
        if search: Glyph {
            source: @image-url("@neoui/icons/sys/search.svg");
            size: 20 * Theme.dp;
            colorize: Theme.text-dim;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: 15.5 * Theme.dp;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                font-family: "DejaVu Sans";
                font-size: 15.5 * Theme.dp;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                input-type: root.keys == 3 ? InputType.number : InputType.text;
                changed has-focus => {
                    if self.has-focus {
                        root.reopen();
                        KeyboardFocus.mode = root.keys;
                        KeyboardFocus.open = true;
                    } else if root.took == KeyboardFocus.seq {
                        KeyboardFocus.open = false;
                    }
                }
                edited => {
                    root.edited(self.text);
                }
            }
        }

        if clearable && root.text != "": Rectangle {
            width: 36 * Theme.dp;
            Glyph {
                source: @image-url("@neoui/icons/sys/close.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }

            TouchArea {
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }
    }

    // the keyboard was put away (the toolbar's key): a tap on the field brings it back, as neoui's TextField does
    if KeyboardFocus.dismissed && input.has-focus: TouchArea {
        clicked => {
            root.reopen();
        }
    }
}
