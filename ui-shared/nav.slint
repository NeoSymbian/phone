import { Act } from "@neoui/kit.slint";
// Where the app is (each of Phone, Contacts and Messages has its own). The app's Rust (symbian/<app>) owns the truth
// and mirrors it here; the screens ask for moves through `act`.

export global Nav {
    // phone_core::page `Page::nav`: 0 Phone, 1 Contacts, 3 the call screens, 4 Settings, 6 Messages (each app shows
    // its own)
    in-out property <int> page;
    // the page's sub-view: Phone "" | "recents" | "detail" | "speed"; Contacts "" | "card" | "edit" | "mark";
    // Settings "" | "blocked" | "replies"; Messages "" | "thread" | "new" | "blocked"
    in-out property <string> view;
    // The kit header (Shell v2: the app draws it), as each view describes itself (symbian/app ctx.rs `Chrome`): its
    // title; ← when there is a page to go up to; a form's [✕ title ✓]; one icon action (the + of a list), or a big
    // action in the content (`pill`: Call, D14); the ⋮ items; Phone | Contacts dots. A full-screen view (a call) has
    // none.
    in property <string> title;
    in property <bool> sub;
    in property <bool> form;
    in property <bool> has-action;
    // the action's glyph: 1 call, 2 add, 3 person_add, 4 edit, 5 check, 6 delete (symbian/app ctx.rs `tool`)
    in property <int> action-tool;
    in property <string> action-label;
    in property <bool> pill;
    in property <[string]> options;
    // more header icons after the action (the card's ★ and ✎): "action" i from 1
    in property <[Act]> actions;
    // the header's search (🔍 opens a field over the title): typed text comes through `searched`
    in property <bool> search;
    in property <string> search-hint: "Search";
    in-out property <string> query;
    in-out property <bool> searching;
    // selection mode: [✕ N selected · selection-actions]; "selection" i, "selection-closed"
    in property <int> selected;
    in property <[Act]> selection-actions;
    in property <bool> full;
    // a root view: the footer that switches between Phone, Contacts and Messages, with their badges
    in property <bool> footer;
    in property <int> missed;
    in property <int> unread;
    // the frame's taps: "back" (← or ✕), "action" i (0 the action: the icon, ✓ or the pill; 1.. the `actions`),
    // "option" i (an item of ⋮), "selection" i, "selection-closed", "tab" i (the footer: 0 Phone, 1 Contacts,
    // 2 Messages)
    callback header(string, int);
    callback searched(string);
}
