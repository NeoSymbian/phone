// SPDX-License-Identifier: GPL-3.0-only
// Messages: the conversations, a thread, a new message, the blocked messages: what the app shows and what the
// screens ask for (`act`). The app (symbian/app/src/msgs.rs) fills it from MODEMD's messages; the search text, the
// composer and the To field are written by the screens.

// A conversation (mockup 28). `known`: a contact (initials) or a number (#).
export struct ThreadRow {
    name: string,
    initials: string,
    tint: color,
    known: bool,
    snippet: string,
    when: string,
    unread: int,
    failed: bool,
}

// A bubble (mockup 29): `band` is the day band before it ("" none); `state` 0 received, 1 sending, 2 sent,
// 3 delivered, 4 not sent.
export struct Bubble {
    id: int,
    text: string,
    mine: bool,
    time: string,
    state: int,
    band: string,
}

// A contact's number matching what is typed in To (mockup 32).
export struct Suggestion {
    name: string,
    detail: string,
    initials: string,
    tint: color,
}

// A blocked message (mockup 35).
export struct BlockedMessage {
    id: int,
    band: string,
    title: string,
    snippet: string,
    why: string,
    when: string,
    initials: string,
    tint: color,
    known: bool,
}

export global MessagesState {
    // the list: its rows (already filtered by the search text)
    in property <[ThreadRow]> threads;
    in-out property <string> search;
    in property <bool> empty: true;
    // the thread: its title (the contact's name or the number) and bubbles, oldest first
    in property <string> title;
    in property <[Bubble]> bubbles;
    // the composer's text (written by the field), its counter ("138 left · 1 SMS"), whether Send works
    in-out property <string> draft;
    in property <string> counter;
    in property <bool> can-send;
    // the composer takes the focus when the view opens (Write your own…)
    in-out property <bool> autofocus;
    // the new message: the chosen recipients' names, what is typed in To, the contacts matching it
    in property <[string]> recipients;
    in-out property <string> to-text;
    in property <[Suggestion]> suggestions;
    // the held bubble's sheet: its items ("" = closed)
    in property <[string]> bubble-items;
    in property <bool> bubble-open;
    // the details dialog: its lines
    in property <bool> details-open;
    in property <[string]> details-keys;
    in property <[string]> details-values;
    // the blocked messages
    in property <[BlockedMessage]> blocked;
    // the held blocked message's sheet
    in property <bool> blocked-open;

    // "open" + thread index, "search" + text, "draft" + text, "send", "hold" + bubble id, "tap" + bubble id,
    // "bubble" + item, "dismiss", "to" + text, "pick" + suggestion index, "unpick" + recipient index,
    // "details-close", "confirm", "cancel", "blocked" + id, "blocked-item" + item
    callback act(string, string);
}
