// SPDX-License-Identifier: GPL-3.0-only
// Settings (Phone, Contacts and Messages), Blocked numbers, Quick replies and their forms: what the app shows and what
// the screens ask for (`act`).

// One row of Blocked numbers. `kind`: 0 a contact's number (avatar, `tint` the palette index), 1 a number (#), 2 a
// prefix (block glyph).
export struct BlockRow {
    title: string,
    subtitle: string,
    initials: string,
    tint: int,
    kind: int,
}

export global SettingsState {
    // Calls: caller ID (modem_ipc::clir 0 network, 1 hide, 2 show), call waiting (modem_ipc::waiting: 0 unknown,
    // 1 busy, 2 on, 3 off, 4 error; the app shows 1 while it asks, 4 when no answer came), the local switches, the voicemail number
    in property <int> clir;
    in property <int> waiting;
    in property <bool> summary;
    in property <bool> show-duration;
    in property <string> voicemail;
    in property <int> blocked-count;
    // Log: days kept (0, 1, 10, 30)
    in property <int> log-days: 30;
    // Contacts: 0 First Last, 1 Last First; the default number type, as an index into `labels`
    in property <int> name-order;
    in property <bool> smart-dial;
    in property <[string]> labels: ["Mobile"];
    in property <int> default-label;
    // Messages: delivery reports, the message centre (from the SIM), the alert (modem_ipc::sms ALERT_*: 0 tone +
    // vibrate, 1 vibrate, 2 silent), the quick replies
    in property <bool> sms-reports: true;
    in property <string> smsc;
    in property <int> sms-alert;
    in property <[string]> replies;

    // the section the page opens at (AppEvent::Open's arg): "" the top, "messages", "contacts"
    in property <string> section;
    // bumped by every open (prefs::open_at): a page already showing scrolls to `section` and reads again
    in property <int> opens;
    // the open picker: "" none, "clir", "log", "order", "label", "alert"
    in-out property <string> picker;
    // the open form, under the header's [✕ title ✓]: "" none, "voicemail", "smsc" (the message centre), "block"
    // (Block a number, with `add-prefix`), "reply" (a new quick reply); what is typed in it
    in-out property <string> form;
    in-out property <string> draft;
    in-out property <bool> add-prefix;

    // Blocked numbers
    in property <bool> block-private;
    in property <bool> block-unknown;
    in property <[BlockRow]> rules;
    // ⋮ ▸ Remove all: the confirmation (the shell's dialog)
    in-out property <bool> query;

    // "opened" (the main view appeared: close what was left open, ask the network about call waiting),
    // "clir" | "log" | "order" | "label" + the picked index, "waiting" | "summary" | "duration" | "smart-dial" |
    // "private" | "unknown" | "reports" + "1" | "0",
    // "waiting-check" (ask the network again), "blocked" (open Blocked numbers), "remove" + the row index,
    // "remove-all", "alert" + the picked index, "replies" (open Quick replies), "remove-reply" + index
    callback act(string, string);
}
