// Phone & Contacts settings (mockups 23, 34) and Blocked numbers (mockup 25), with the pickers, the voicemail and
// message centre editors, the add row and the Remove all query; Quick replies.
import { Theme } from "@neoui/theme.slint";
import { NeoList } from "@neoui/components/scroll.slint";
import { TextField } from "@neoui/components/controls.slint";
import { Alphabets } from "@neoui/components/keyboard/glyphs.slint";
import { Nav } from "../nav.slint";
import { Band, Sheet, Avatar, Glyph } from "../common.slint";
import { SettingsState } from "state.slint";

// The mockups' switch: green when on; `busy` dims it while the network answers.
component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> busy;
    callback toggled(bool);
    width: 44 * Theme.dp;
    height: 26 * Theme.dp;
    border-radius: self.height / 2;
    background: on ? Theme.ok : #3a3f47;
    opacity: busy ? 0.45 : 1;
    Rectangle {
        x: on ? parent.width - self.width - 3 * Theme.dp : 3 * Theme.dp;
        width: 20 * Theme.dp;
        height: self.width;
        border-radius: self.width / 2;
        background: white;
    }

    TouchArea {
        enabled: !busy;
        clicked => {
            root.toggled(!on);
        }
    }
}

// A settings row: a title (and a subtitle), then a value with a chevron or a switch. `first`: no line above.
component Row inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <bool> toggle;
    in property <bool> on;
    in property <bool> busy;
    in property <bool> first;
    callback clicked;
    callback toggled(bool);
    height: 48 * Theme.dp;
    background: touch.pressed && !toggle ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            if toggle {
                if !busy {
                    root.toggled(!on);
                }
            } else {
                root.clicked();
            }
        }
    }

    if !first: Rectangle {
        x: 14 * Theme.dp;
        y: 0;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
    HorizontalLayout {
        padding-left: 14 * Theme.dp;
        padding-right: 14 * Theme.dp;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            spacing: 2 * Theme.dp;
            horizontal-stretch: 1;
            Text {
                text: title;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
            }

            if subtitle != "": Text {
                text: subtitle;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        if value != "": HorizontalLayout {
            spacing: 2 * Theme.dp;
            Text {
                text: value;
                color: Theme.text-secondary;
                font-size: 14 * Theme.dp;
                vertical-alignment: center;
            }

            Glyph {
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
                y: (parent.height - self.height) / 2;
            }
        }
        if toggle: Toggle {
            y: (parent.height - self.height) / 2;
            on: on;
            busy: busy;
            toggled(v) => {
                root.toggled(v);
            }
        }
    }
}

component Main inherits NeoList {
    property <[string]> clir-names: ["Network", "Hidden", "Shown"];
    init => {
        SettingsState.act("opened", "");
    }
    VerticalLayout {
        alignment: start;
        Band { text: "CALLS"; }
        Row {
            title: "Send my caller ID";
            value: clir-names[SettingsState.clir];
            first: true;
            clicked => {
                SettingsState.picker = "clir";
            }
        }

        Row {
            height: 60 * Theme.dp;
            title: "Call waiting";
            subtitle: SettingsState.waiting == 1 ? "Checking with network…"
                : SettingsState.waiting == 4 ? "Couldn't check" : "Checked with network";
            toggle: true;
            on: SettingsState.waiting == 2;
            busy: SettingsState.waiting == 1;
            toggled(v) => {
                SettingsState.act("waiting", v ? "1" : "0");
            }
        }

        Row {
            title: "Summary after call";
            toggle: true;
            on: SettingsState.summary;
            toggled(v) => {
                SettingsState.act("summary", v ? "1" : "0");
            }
        }

        Row {
            title: "Show call duration";
            toggle: true;
            on: SettingsState.show-duration;
            toggled(v) => {
                SettingsState.act("duration", v ? "1" : "0");
            }
        }

        if !SettingsState.editing: Row {
            title: "Voicemail number";
            value: SettingsState.voicemail == "" ? "Not set" : SettingsState.voicemail;
            clicked => {
                SettingsState.draft = SettingsState.voicemail;
                SettingsState.editing = true;
            }
        }
        if SettingsState.editing: Rectangle {
            height: 64 * Theme.dp;
            background: Theme.bg-raised;
            HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: "Voicemail";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }

                TextField {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    text <=> SettingsState.draft;
                    placeholder: "Number";
                    keys: 4;
                    autofocus: true;
                }
            }
        }
        Row {
            title: "Blocked numbers";
            value: SettingsState.blocked-count;
            clicked => {
                SettingsState.act("blocked", "");
            }
        }

        Band { text: "LOG"; }
        Row {
            title: "Keep call log";
            value: SettingsState.log-days == 0 ? "Don't keep" : SettingsState.log-days == 1 ? "1 day"
                : "\{SettingsState.log-days} days";
            first: true;
            clicked => {
                SettingsState.picker = "log";
            }
        }

        Band { text: "CONTACTS"; }
        Row {
            title: "Name display";
            value: SettingsState.name-order == 1 ? "Last First" : "First Last";
            first: true;
            clicked => {
                SettingsState.picker = "order";
            }
        }

        Row {
            title: "Smart dial";
            toggle: true;
            on: SettingsState.smart-dial;
            toggled(v) => {
                SettingsState.act("smart-dial", v ? "1" : "0");
            }
        }

        Row {
            title: "Default number type";
            value: SettingsState.labels[SettingsState.default-label];
            clicked => {
                SettingsState.picker = "label";
            }
        }

        // mockup 34
        Band { text: "MESSAGES"; }
        Row {
            height: 60 * Theme.dp;
            title: "Delivery reports";
            subtitle: "Shows ✓✓ when a message arrives";
            toggle: true;
            on: SettingsState.sms-reports;
            first: true;
            toggled(v) => {
                SettingsState.act("reports", v ? "1" : "0");
            }
        }

        if !SettingsState.editing-smsc: Row {
            height: 60 * Theme.dp;
            title: "Message centre";
            subtitle: "From the SIM";
            value: SettingsState.smsc == "" ? "Unknown" : SettingsState.smsc;
            clicked => {
                SettingsState.draft = SettingsState.smsc;
                SettingsState.editing = false;
                SettingsState.editing-smsc = true;
            }
        }
        if SettingsState.editing-smsc: Rectangle {
            height: 64 * Theme.dp;
            background: Theme.bg-raised;
            HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: "Centre";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }

                TextField {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    text <=> SettingsState.draft;
                    placeholder: "Number";
                    keys: 4;
                    autofocus: true;
                }
            }
        }
        Row {
            title: "Quick replies";
            value: SettingsState.replies.length;
            clicked => {
                SettingsState.act("replies", "");
            }
        }

        Row {
            title: "New message alert";
            value: SettingsState.sms-alert == 1 ? "Vibrate" : SettingsState.sms-alert == 2 ? "Silent" : "Tone + vibrate";
            clicked => {
                SettingsState.picker = "alert";
            }
        }

        HorizontalLayout {
            padding: 14 * Theme.dp;
            Text {
                text: "Blocked numbers apply to messages when their Messages box is ticked.";
                color: Theme.text-secondary;
                font-size: 13 * Theme.dp;
                wrap: word-wrap;
            }
        }
    }
}

// Quick replies: the texts Reply with message offers (up to 6), the add row on top.
component Replies inherits NeoList {
    VerticalLayout {
        alignment: start;
        if SettingsState.adding: Rectangle {
            background: Theme.bg-raised;
            VerticalLayout {
                padding: 14 * Theme.dp;
                padding-top: 12 * Theme.dp;
                TextField {
                    text <=> SettingsState.add-text;
                    placeholder: "A short reply";
                    autofocus: true;
                }
            }
        }
        Band { text: "REPLY WITH MESSAGE · \{SettingsState.replies.length}"; }
        for r[i] in SettingsState.replies: Rectangle {
            height: 56 * Theme.dp;
            if i > 0: Rectangle {
                x: 14 * Theme.dp;
                y: 0;
                width: parent.width - self.x;
                height: max(1px, Theme.dp / 2);
                background: Theme.hairline;
            }
            HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: r;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 34 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: rm.pressed ? Theme.danger.with-alpha(0.35) : Theme.danger.with-alpha(0.15);
                    Glyph {
                        source: @image-url("@neoui/icons/sys/close.svg");
                        size: 16 * Theme.dp;
                        colorize: Theme.danger;
                    }

                    rm := TouchArea {
                        clicked => {
                            SettingsState.act("remove-reply", i);
                        }
                    }
                }
            }
        }
    }
}

// A check box with its label ("Whole prefix").
component Check inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled;
    height: 40 * Theme.dp;
    HorizontalLayout {
        spacing: 12 * Theme.dp;
        Rectangle {
            width: 22 * Theme.dp;
            height: 22 * Theme.dp;
            y: (parent.height - self.height) / 2;
            border-radius: 6 * Theme.dp;
            background: checked ? Theme.accent : transparent;
            border-width: checked ? 0 : 2 * Theme.dp;
            border-color: Theme.text-dim;
            if checked: Glyph {
                source: @image-url("@neoui/icons/sys/check.svg");
                size: 16 * Theme.dp;
            }
        }

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component Blocked inherits NeoList {
    VerticalLayout {
        min-height: root.height;
        if SettingsState.adding: Rectangle {
            background: Theme.bg-raised;
            VerticalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                padding-top: 12 * Theme.dp;
                padding-bottom: 6 * Theme.dp;
                spacing: 6 * Theme.dp;
                TextField {
                    text <=> SettingsState.add-text;
                    placeholder: "Number or prefix";
                    keys: 4;
                    autofocus: true;
                }

                Check {
                    text: "Whole prefix";
                    checked: SettingsState.add-prefix;
                    toggled => {
                        SettingsState.add-prefix = !SettingsState.add-prefix;
                    }
                }
            }
        }
        Band { text: "BLOCK AUTOMATICALLY"; }
        Row {
            height: 62 * Theme.dp;
            title: "Private numbers";
            subtitle: "Callers who hide their number";
            toggle: true;
            on: SettingsState.block-private;
            first: true;
            toggled(v) => {
                SettingsState.act("private", v ? "1" : "0");
            }
        }

        Row {
            height: 62 * Theme.dp;
            title: "Unknown numbers";
            subtitle: "Anyone not in your contacts";
            toggle: true;
            on: SettingsState.block-unknown;
            toggled(v) => {
                SettingsState.act("unknown", v ? "1" : "0");
            }
        }

        Band { text: "BLOCKED · \{SettingsState.rules.length}"; }
        for r[i] in SettingsState.rules: Rectangle {
            height: 72 * Theme.dp;
            if i > 0: Rectangle {
                x: 70 * Theme.dp;
                y: 0;
                width: parent.width - self.x;
                height: max(1px, Theme.dp / 2);
                background: Theme.hairline;
            }
            HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 12 * Theme.dp;
                if r.kind == 0: Avatar {
                    y: (parent.height - self.height) / 2;
                    initials: r.initials;
                    tint: r.tint;
                }
                if r.kind != 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Theme.avatar;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #2b3038;
                    Glyph {
                        source: r.kind == 2 ? @image-url("../icons/block.svg") : @image-url("../icons/hash.svg");
                        size: 22 * Theme.dp;
                        colorize: Theme.text-secondary;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2 * Theme.dp;
                    horizontal-stretch: 1;
                    Text {
                        text: r.title;
                        font-family: r.kind == 0 ? "DejaVu Sans" : "";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }

                    Text {
                        text: r.subtitle;
                        color: Theme.text-secondary;
                        font-size: Theme.font-label;
                        overflow: elide;
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 34 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: rm.pressed ? Theme.danger.with-alpha(0.35) : Theme.danger.with-alpha(0.15);
                    Glyph {
                        source: @image-url("@neoui/icons/sys/close.svg");
                        size: 16 * Theme.dp;
                        colorize: Theme.danger;
                    }

                    rm := TouchArea {
                        clicked => {
                            SettingsState.act("remove", i);
                        }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: 14 * Theme.dp;
            padding-right: 14 * Theme.dp;
            padding-bottom: 14 * Theme.dp;
            Text {
                text: "Blocked calls are kept under Recent calls ▸ Blocked for 7 days. Emergency numbers are never blocked.";
                font-family: "DejaVu Sans";
                color: Theme.text-secondary;
                font-size: 13 * Theme.dp;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    // the open picker's heading, choices and the one chosen
    property <string> picker: SettingsState.picker;
    // bakes in the glyphs of contacts' names (Armenian, Cyrillic) for the blocked rows
    Alphabets { }
    VerticalLayout {
        if Nav.view == "": Main { }
        if Nav.view == "blocked": Blocked { }
        if Nav.view == "replies": Replies { }
    }

    Sheet {
        open: picker != "";
        heading: picker == "clir" ? "Send my caller ID" : picker == "log" ? "Keep call log"
            : picker == "order" ? "Name display" : picker == "alert" ? "New message alert" : "Default number type";
        items: picker == "clir" ? ["Network", "Hidden", "Shown"]
            : picker == "log" ? ["Don't keep", "1 day", "10 days", "30 days"]
            : picker == "order" ? ["First Last", "Last First"]
            : picker == "alert" ? ["Tone + vibrate", "Vibrate", "Silent"] : SettingsState.labels;
        marked: picker == "clir" ? SettingsState.clir
            : picker == "log" ? (SettingsState.log-days == 0 ? 0 : SettingsState.log-days == 1 ? 1
                : SettingsState.log-days == 10 ? 2 : 3)
            : picker == "order" ? SettingsState.name-order
            : picker == "alert" ? SettingsState.sms-alert : SettingsState.default-label;
        dismissed => {
            SettingsState.picker = "";
        }
        selected(i, item) => {
            SettingsState.act(picker, i);
            SettingsState.picker = "";
        }
    }
}
