// SPDX-License-Identifier: GPL-3.0-only
// Settings (NEOPHONE v2 p2-phone-settings: Calls, Log, Contacts; p2-msg-settings from Messages: Messages, Blocking,
// caller ID), Blocked numbers
// (p2-phone-blocked), Quick replies (p2-phone-settings-replies), the forms under a [✕ title ✓] header (Voicemail number,
// Message centre, Block a number, a new reply) and the pickers (p2-phone-settings-clir, -log).
import { Theme, NeoList, SectionHeader, ListRow, TextField, Glyph, Alphabets } from "@neoui/kit.slint";
import { Nav } from "@phone-shared/nav.slint";
import { Face, SwitchRow, RadioSheet, ValueRow } from "../parts.slint";
import { SettingsState } from "state.slint";

// The pickers' choices, as the rows show them.
global Names {
    out property <[string]> clir: ["Network", "Hidden", "Shown"];
    out property <[string]> log: ["Don't keep", "1 day", "10 days", "30 days"];
    out property <[string]> order: ["First Last", "Last First"];
    out property <[string]> alerts: ["Tone + vibrate", "Vibrate", "Silent"];
}

component Note inherits HorizontalLayout {
    in property <string> text;
    in property <length> size: Theme.font-label;
    padding-left: 16 * Theme.dp;
    padding-right: 16 * Theme.dp;
    padding-top: 14 * Theme.dp;
    padding-bottom: 14 * Theme.dp;
    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: root.size;
        wrap: word-wrap;
    }
}

// Call waiting: the network's answer; unknown or unanswered, a tap asks again (the switch only flips a known state).
component WaitingRow inherits SwitchRow {
    property <int> w: SettingsState.waiting;
    title: "Call waiting";
    subtitle: w == 0 ? "Unknown · tap to check" : w == 1 ? "Checking with network…"
        : w == 4 ? "Couldn't check" : "Checked with network";
    on: w == 2;
    busy: w == 1;
    toggled(v) => {
        if w == 0 || w == 4 {
            SettingsState.act("waiting-check", "");
        } else {
            SettingsState.act("waiting", v ? "1" : "0");
        }
    }
}

// The settings opened from Phone (p2-phone-settings): Calls, Log, Contacts; from Contacts it opens at Contacts.
component PhoneMain inherits NeoList {
    init => {
        self.arrive();
    }
    property <int> opens: SettingsState.opens;
    changed opens => {
        self.arrive();
    }
    // opened (again): read what may have changed, and Contacts on top when Contacts asked for it
    function arrive() {
        SettingsState.act("opened", "");
        self.content-y = SettingsState.section == "contacts" ? -contacts.y : 0;
    }
    VerticalLayout {
        alignment: start;
        SectionHeader {
            text: "Calls";
        }

        ListRow {
            title: "Send my caller ID";
            subtitle: Names.clir[SettingsState.clir];
            chevron: true;
            clicked => {
                SettingsState.picker = "clir";
            }
        }

        WaitingRow { }

        SwitchRow {
            title: "Summary after call";
            subtitle: "Show call duration";
            on: SettingsState.summary;
            toggled(v) => {
                SettingsState.act("summary", v ? "1" : "0");
            }
        }

        ListRow {
            title: "Voicemail number";
            subtitle: SettingsState.voicemail == "" ? "Not set" : SettingsState.voicemail;
            chevron: true;
            clicked => {
                SettingsState.act("form", "voicemail");
            }
        }

        ValueRow {
            title: "Blocked numbers";
            value: SettingsState.blocked-count;
            clicked => {
                SettingsState.act("blocked", "");
            }
        }

        SectionHeader {
            text: "Log";
        }

        ListRow {
            title: "Keep call log";
            subtitle: SettingsState.log-days == 0 ? "Don't keep" : SettingsState.log-days == 1 ? "1 day"
                : "\{SettingsState.log-days} days";
            chevron: true;
            clicked => {
                SettingsState.picker = "log";
            }
        }

        contacts := SectionHeader {
            text: "Contacts";
        }

        ListRow {
            title: "Name display";
            subtitle: SettingsState.name-order == 1 ? "Last First" : "First Last";
            chevron: true;
            clicked => {
                SettingsState.picker = "order";
            }
        }

        SwitchRow {
            title: "Smart dial";
            on: SettingsState.smart-dial;
            toggled(v) => {
                SettingsState.act("smart-dial", v ? "1" : "0");
            }
        }

        ListRow {
            title: "Default number type";
            subtitle: SettingsState.labels[SettingsState.default-label];
            chevron: true;
            divider: false;
            clicked => {
                SettingsState.picker = "label";
            }
        }

        // room under Contacts, so the page can open with it on top
        if SettingsState.section == "contacts": Rectangle {
            height: max(0px, root.height - Theme.section-h - 2 * Theme.list-row-double-h - Theme.list-row-h);
        }
    }
}

// The same settings opened from Messages (p2-msg-settings): Messages, Blocking, then Calls' caller ID.
component MessagesMain inherits NeoList {
    init => {
        SettingsState.act("opened", "");
    }
    property <int> opens: SettingsState.opens;
    changed opens => {
        SettingsState.act("opened", "");
        self.content-y = 0;
    }
    VerticalLayout {
        alignment: start;
        SectionHeader {
            text: "Messages";
        }

        SwitchRow {
            title: "Delivery reports";
            subtitle: "Shows ✓✓ when a message arrives";
            on: SettingsState.sms-reports;
            toggled(v) => {
                SettingsState.act("reports", v ? "1" : "0");
            }
        }

        ValueRow {
            title: "Message centre";
            subtitle: "From the SIM";
            value: SettingsState.smsc == "" ? "Unknown" : SettingsState.smsc;
            clicked => {
                SettingsState.act("form", "smsc");
            }
        }

        ValueRow {
            title: "Quick replies";
            value: SettingsState.replies.length;
            clicked => {
                SettingsState.act("replies", "");
            }
        }

        ValueRow {
            title: "New message alert";
            value: Names.alerts[SettingsState.sms-alert];
            divider: false;
            clicked => {
                SettingsState.picker = "alert";
            }
        }

        SectionHeader {
            text: "Blocking";
        }

        ValueRow {
            title: "Blocked numbers";
            value: SettingsState.blocked-count;
            divider: false;
            clicked => {
                SettingsState.act("blocked", "");
            }
        }

        Note {
            text: "Blocked numbers apply to messages when their Messages box is ticked.";
            size: 13 * Theme.dp;
            padding-top: 8 * Theme.dp;
            padding-bottom: 4 * Theme.dp;
        }

        SectionHeader {
            text: "Calls";
        }

        ValueRow {
            title: "Send my caller ID";
            value: Names.clir[SettingsState.clir];
            divider: false;
            clicked => {
                SettingsState.picker = "clir";
            }
        }
    }
}

// A round ✕ that removes a row (a blocked number, a quick reply).
component Remove inherits Rectangle {
    in property <bool> red;
    callback clicked;
    width: 40 * Theme.dp;
    height: self.width;
    border-radius: self.width / 2;
    background: t.pressed ? Theme.pressed : red ? Theme.danger.with-alpha(0.15) : transparent;
    Glyph {
        source: @image-url("@neoui/icons/sys/close.svg");
        size: (red ? 16 : 22) * Theme.dp;
        colorize: red ? Theme.danger : Theme.text-secondary;
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Quick replies (p2-phone-settings-replies): the texts Reply with message offers (up to 6).
component Replies inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader {
            text: "Reply with message · \{SettingsState.replies.length}";
        }

        for r[i] in SettingsState.replies: Rectangle {
            height: Theme.list-row-h;
            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 10 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: r;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Remove {
                        red: true;
                        width: 34 * Theme.dp;
                        clicked => {
                            SettingsState.act("remove-reply", i);
                        }
                    }
                }
            }

            Rectangle {
                x: 16 * Theme.dp;
                y: parent.height - self.height;
                width: parent.width - self.x;
                height: max(1px, Theme.dp / 2);
                background: Theme.header-hairline;
            }
        }
    }
}

// Blocked numbers (p2-phone-blocked).
component Blocked inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader {
            text: "Block automatically";
        }

        SwitchRow {
            title: "Private numbers";
            subtitle: "Callers who hide their number";
            on: SettingsState.block-private;
            toggled(v) => {
                SettingsState.act("private", v ? "1" : "0");
            }
        }

        SwitchRow {
            title: "Unknown numbers";
            subtitle: "Anyone not in your contacts";
            on: SettingsState.block-unknown;
            toggled(v) => {
                SettingsState.act("unknown", v ? "1" : "0");
            }
        }

        SectionHeader {
            text: "Blocked · \{SettingsState.rules.length}";
        }

        for r[i] in SettingsState.rules: Rectangle {
            height: Theme.list-row-double-h;
            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 10 * Theme.dp;
                spacing: 14 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    Face {
                        initials: r.initials;
                        tint: r.kind == 0 ? r.tint : -1;
                        glyph: r.kind == 2 ? 2 : 0;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3 * Theme.dp;
                    horizontal-stretch: 1;
                    Text {
                        text: r.title;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 500;
                        overflow: elide;
                    }

                    Text {
                        text: r.subtitle;
                        color: Theme.text-secondary;
                        font-size: Theme.font-label;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Remove {
                        clicked => {
                            SettingsState.act("remove", i);
                        }
                    }
                }
            }

            Rectangle {
                x: 74 * Theme.dp;
                y: parent.height - self.height;
                width: parent.width - self.x;
                height: max(1px, Theme.dp / 2);
                background: Theme.header-hairline;
            }
        }
        Note {
            text: "Blocked calls are kept under Recent calls ▸ Blocked for 7 days. Emergency numbers are never blocked.";
        }
    }
}

// A form under the header's [✕ title ✓] (p2-phone-settings-voicemail, p2-phone-blocked-add): one field, the phone
// keyboard (letters for a reply), "Whole prefix" for a blocked number.
component Form inherits VerticalLayout {
    alignment: start;
    padding-left: 16 * Theme.dp;
    padding-right: 16 * Theme.dp;
    padding-top: 12 * Theme.dp;
    spacing: 10 * Theme.dp;
    TextField {
        text <=> SettingsState.draft;
        placeholder: SettingsState.form == "reply" ? "A short reply" : SettingsState.form == "block" ? "Number or prefix" : "Number";
        keys: SettingsState.form == "reply" ? 1 : 4;
        autofocus: true;
    }

    if SettingsState.form == "block": Rectangle {
        height: 40 * Theme.dp;
        HorizontalLayout {
            spacing: 12 * Theme.dp;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20 * Theme.dp;
                    height: self.width;
                    border-radius: 4 * Theme.dp;
                    background: SettingsState.add-prefix ? Theme.accent : transparent;
                    border-width: SettingsState.add-prefix ? 0 : 2 * Theme.dp;
                    border-color: Theme.text-dim;
                    if SettingsState.add-prefix: Glyph {
                        source: @image-url("@neoui/icons/sys/check.svg");
                        size: 15 * Theme.dp;
                        colorize: white;
                    }
                }
            }

            Text {
                text: "Whole prefix";
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => {
                SettingsState.add-prefix = !SettingsState.add-prefix;
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <string> picker: SettingsState.picker;
    // bakes in the glyphs of contacts' names (Armenian, Cyrillic) for the blocked rows
    Alphabets { }
    if SettingsState.form != "": Form { }
    if SettingsState.form == "" && Nav.view == "" && SettingsState.section != "messages": PhoneMain { }
    if SettingsState.form == "" && Nav.view == "" && SettingsState.section == "messages": MessagesMain { }
    if SettingsState.form == "" && Nav.view == "blocked": Blocked { }
    if SettingsState.form == "" && Nav.view == "replies": Replies { }
    // made open (the kit sheet keeps its own `open`): `picker` shows and hides it, and Back closes it in the app
    if picker != "": RadioSheet {
        open: true;
        heading: picker == "clir" ? "Send my caller ID" : picker == "log" ? "Keep call log"
            : picker == "order" ? "Name display" : picker == "alert" ? "New message alert" : "Default number type";
        choices: picker == "clir" ? Names.clir : picker == "log" ? Names.log : picker == "order" ? Names.order
            : picker == "alert" ? Names.alerts : SettingsState.labels;
        current: picker == "clir" ? SettingsState.clir
            : picker == "log" ? (SettingsState.log-days == 0 ? 0 : SettingsState.log-days == 1 ? 1
                : SettingsState.log-days == 10 ? 2 : 3)
            : picker == "order" ? SettingsState.name-order
            : picker == "alert" ? SettingsState.sms-alert : SettingsState.default-label;
        dismissed => {
            SettingsState.picker = "";
        }
        chosen(i) => {
            SettingsState.act(root.picker, i);
            SettingsState.picker = "";
        }
    }
}
