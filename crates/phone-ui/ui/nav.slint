// SPDX-License-Identifier: GPL-3.0-only
// Where the app is. The app (src/lib.rs in symbian/app) owns the truth and mirrors it here; the screens ask for moves
// through `act`.

export global Nav {
    // 0 Phone, 1 Contacts, 3 the call screens, 4 Settings, 6 Messages (the UI server's page numbers; 2 Recents and
    // 5 Speed dial are views of Phone)
    in-out property <int> page;
    // the page's sub-view: Phone "" | "recents" | "detail" | "speed"; Contacts "" | "card" | "edit" | "mark";
    // Settings "" | "blocked" | "replies"; Messages "" | "thread" | "new" | "blocked"
    in-out property <string> view;
    // The kit header (Shell v2: the app draws it), as each view describes itself (symbian/app ctx.rs `Chrome`): its
    // title; ← when there is a page to go up to; a form's [✕ title ✓]; one icon action (the + of a list), or a big
    // action in the content (`pill`: Call, D14); the ⋮ items; Phone | Contacts dots. A full-screen view (a call) has
    // none.
    in property <string> title;
    in property <bool> sub;
    in property <bool> form;
    in property <bool> has-action;
    // the action's glyph: 1 call, 2 add, 3 person_add, 4 edit, 5 check, 6 delete (symbian/app ctx.rs `tool`)
    in property <int> action-tool;
    in property <string> action-label;
    in property <bool> pill;
    in property <[string]> options;
    in property <int> dots;
    in property <int> dot;
    in property <bool> full;
    // the header's taps: "back" (← or ✕), "action" (the icon, ✓ or the pill), "option" i (an item of ⋮)
    callback header(string, int);
    // "switch" + "0" | "1" (Phone | Contacts: a sideways swipe on the dialer or the contact list)
    callback act(string, string);
}
