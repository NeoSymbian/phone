// SPDX-License-Identifier: GPL-3.0-only
// Phone (NEOPHONE v2 p2-phone-*): Recents with filter chips, day sections and the keypad Fab (the root); the keypad
// sheet over it with smart-dial matches above; selection mode; call details; speed dial with its contact sheet. The
// header, the ⋮ menu and the footer are the frame's (ui-shared/frame.slint).
import { Theme, NeoList, SectionHeader, Chip, Fab, Keypad, Sheet, ListRow, EmptyState, Glyph, Alphabets } from "@neoui/kit.slint";
import { Nav } from "@phone-shared/nav.slint";
import { RowAction } from "@phone-shared/common.slint";
import { Face, Direction, Pill, Heading, Dashed } from "../parts.slint";
import { DialState, LogRow, MatchRow } from "state.slint";

component Hairline inherits Rectangle {
    in property <length> left;
    Rectangle {
        x: left;
        y: parent.height - self.height;
        width: parent.width - left;
        height: max(1px, Theme.dp / 2);
        background: Theme.header-hairline;
    }
}

// A Recents row (p2-phone-recents, -select): tap = details (a toggle while selecting), hold = selection mode, the
// green button calls back.
component LogLine inherits Rectangle {
    in property <LogRow> r;
    in property <bool> divider: true;
    property <bool> fired;
    height: Theme.list-row-double-h;
    background: touch.pressed ? Theme.pressed : r.checked ? Theme.selected : transparent;
    touch := TouchArea {
        changed pressed => {
            if self.pressed {
                root.fired = false;
            }
        }
        clicked => {
            if !root.fired {
                DialState.act("row", r.id);
            }
        }
    }

    Timer {
        interval: 500ms;
        running: touch.pressed && !root.fired && !DialState.selecting;
        triggered => {
            root.fired = true;
            DialState.act("row-hold", r.id);
        }
    }

    HorizontalLayout {
        padding-left: 16 * Theme.dp;
        padding-right: 12 * Theme.dp;
        spacing: 14 * Theme.dp;
        if DialState.selecting: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: r.checked ? Theme.accent : transparent;
                border-width: r.checked ? 0 : 2 * Theme.dp;
                border-color: Theme.text-dim;
                if r.checked: Glyph {
                    source: @image-url("@neoui/icons/sys/check.svg");
                    size: 16 * Theme.dp;
                    colorize: white;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Face {
                initials: r.initials;
                tint: r.tint;
                glyph: r.private ? 1 : 0;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            Text {
                text: r.title + (r.count > 1 ? " (" + r.count + ")" : "");
                color: r.kind == 3 ? Theme.danger : Theme.text;
                font-size: Theme.font-body;
                font-weight: 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 5 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    Direction {
                        kind: r.kind;
                        size: 15 * Theme.dp;
                    }
                }

                Text {
                    text: r.line;
                    color: r.kind == 3 ? Theme.danger : Theme.text-secondary;
                    font-size: Theme.font-label;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        if r.kind != 5 && !DialState.selecting: VerticalLayout {
            alignment: center;
            RowAction {
                icon: @image-url("@neoui/icons/sys/call.svg");
                clicked => {
                    DialState.act("row-call", r.id);
                }
            }
        }
    }

    if divider: Hairline {
        left: (DialState.selecting ? 112 : 74) * Theme.dp;
    }
}

// Text with a lit middle part (smart dial's matched letters or digits, in the accent).
component Lit inherits HorizontalLayout {
    in property <string> pre;
    in property <string> hit;
    in property <string> post;
    in property <length> size;
    in property <color> color;
    in property <int> weight: 400;
    Text {
        text: pre;
        font-size: size;
        font-weight: weight;
        color: color;
    }

    Text {
        text: hit;
        font-size: size;
        font-weight: weight;
        color: Theme.accent;
    }

    Text {
        text: post;
        font-size: size;
        font-weight: weight;
        color: color;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// A contact the typed digits match (p2-phone-typing): tap or the green button calls its number.
component MatchLine inherits Rectangle {
    in property <MatchRow> m;
    in property <int> index;
    height: Theme.list-row-double-h;
    background: t.pressed ? Theme.pressed : transparent;
    t := TouchArea {
        clicked => {
            DialState.act("match", index);
        }
    }

    HorizontalLayout {
        padding-left: 16 * Theme.dp;
        padding-right: 12 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Face {
                initials: m.initials;
                tint: m.tint;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            Lit {
                pre: m.name-pre;
                hit: m.name-hit;
                post: m.name-post;
                size: Theme.font-body;
                weight: 500;
                color: Theme.text;
            }

            Lit {
                pre: m.label + " · " + m.num-pre;
                hit: m.num-hit;
                post: m.num-post;
                size: Theme.font-label;
                color: Theme.text-secondary;
            }
        }

        VerticalLayout {
            alignment: center;
            RowAction {
                icon: @image-url("@neoui/icons/sys/call.svg");
                clicked => {
                    DialState.act("match", index);
                }
            }
        }
    }

    Hairline {
        left: 74 * Theme.dp;
    }
}

// The filter chips (they scroll sideways when they don't fit; with Blocked on, its chip shows). The kit Chip keeps
// its own on/off, so a cover takes the tap and the app's filter decides.
component Chips inherits Flickable {
    height: 52 * Theme.dp;
    content-width: chips.preferred-width;
    content-height: self.height;
    // the Flickable moves content-x itself (a binding would not survive), so the filter sets it
    property <bool> blocked: DialState.filter == 4;
    function place() {
        self.content-x = self.blocked ? min(0px, self.width - chips.preferred-width) : 0px;
    }
    init => {
        self.place();
    }
    changed blocked => {
        self.place();
    }
    changed width => {
        self.place();
    }
    chips := HorizontalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: 12 * Theme.dp;
        spacing: 6 * Theme.dp;
        alignment: start;
        for c[i] in DialState.has-blocked ? ["All", "Missed", "Received", "Dialled", "Blocked"] : ["All", "Missed", "Received", "Dialled"]: VerticalLayout {
            alignment: center;
            Rectangle {
                width: chip.width;
                height: chip.height;
                chip := Chip {
                    text: c;
                    on: DialState.filter == i;
                    count: i == 1 ? DialState.missed-new : i == 4 ? DialState.blocked-count : 0;
                    count-danger: i == 1;
                }

                TouchArea {
                    clicked => {
                        DialState.act("filter", i);
                    }
                }
            }
        }
    }
}

// Recents (p2-phone-recents, -recents-blocked, -select), or the matches while a number is typed (p2-phone-typing).
component RecentsList inherits VerticalLayout {
    property <bool> typing: Nav.view == "dial" && DialState.number != "";
    property <int> n: DialState.rows.length;
    if !typing && !DialState.searching: Chips { }
    // the search's result count in place of the chips (the prototype's resultText)
    if !typing && DialState.searching: HorizontalLayout {
        height: 34 * Theme.dp;
        padding-left: 16 * Theme.dp;
        Text {
            text: n == 1 ? "1 call" : "\{n} calls";
            color: Theme.text-dim;
            font-size: Theme.font-label;
            vertical-alignment: center;
        }
    }
    if !typing: NeoList {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            for r[i] in DialState.rows: VerticalLayout {
                if i == 0 || DialState.rows[i - 1].section != r.section: SectionHeader {
                    text: r.section;
                }
                LogLine {
                    r: r;
                    divider: i < DialState.rows.length - 1 && DialState.rows[i + 1].section == r.section;
                }
            }
            if DialState.filter == 4 && DialState.rows.length > 0: HorizontalLayout {
                padding: 16 * Theme.dp;
                Text {
                    text: "Blocked calls don't ring, vibrate or count as missed.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-label;
                    wrap: word-wrap;
                }
            }
            if DialState.rows.length == 0: EmptyState {
                height: 360 * Theme.dp;
                icon: @image-url("@neoui/icons/sys/call.svg");
                title: DialState.searching ? "No matches" : DialState.filter == 1 ? "No missed calls"
                    : DialState.filter == 2 ? "No received calls" : DialState.filter == 3 ? "No dialled calls"
                    : DialState.filter == 4 ? "No blocked calls" : "No calls yet";
                reason: DialState.filter == 4 && !DialState.searching ? "Blocked calls don't ring, vibrate or count as missed." : "";
            }
            // the last row clears the Fab
            Rectangle {
                height: 88 * Theme.dp;
            }
        }
    }
    if typing: NeoList {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            for m[i] in DialState.matches: MatchLine {
                m: m;
                index: i;
            }
            Rectangle {
                height: 56 * Theme.dp;
                background: add.pressed ? Theme.pressed : transparent;
                HorizontalLayout {
                    padding-left: 16 * Theme.dp;
                    spacing: 14 * Theme.dp;
                    alignment: start;
                    HorizontalLayout {
                        width: 44 * Theme.dp;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                source: @image-url("@neoui/icons/sys/person_add.svg");
                                size: 24 * Theme.dp;
                                colorize: Theme.accent;
                            }
                        }
                    }

                    Text {
                        text: "Add to contacts";
                        color: Theme.accent;
                        font-size: Theme.font-body;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                add := TouchArea {
                    clicked => {
                        DialState.act("add-contact", "");
                    }
                }
            }
        }
    }
}

// The keypad sheet (p2-phone-keypad, -typing): the number with backspace (hold: clear), the kit keypad (hold 1:
// voicemail, 2-9: speed dial, 0: +), the green Call.
component KeypadSheet inherits Rectangle {
    property <length> lift: 20 * Theme.dp;
    height: 428 * Theme.dp;
    // the top corners round; the square bottom hangs below the surface
    Rectangle {
        height: parent.height + root.lift;
        y: 0;
        border-top-left-radius: root.lift;
        border-top-right-radius: root.lift;
        background: Theme.bg-raised;
        border-width: max(1px, Theme.dp / 2);
        border-color: Theme.hairline;
    }

    TouchArea { }

    VerticalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: 12 * Theme.dp;
        padding-bottom: 8 * Theme.dp;
        // the handle: a tap puts the sheet away
        Rectangle {
            height: 16 * Theme.dp;
            Rectangle {
                width: 36 * Theme.dp;
                height: 4 * Theme.dp;
                border-radius: 2 * Theme.dp;
                background: Theme.handle;
            }

            TouchArea {
                clicked => {
                    DialState.act("keypad-close", "");
                }
            }
        }

        HorizontalLayout {
            height: 56 * Theme.dp;
            padding-left: 48 * Theme.dp;
            Text {
                text: DialState.number == "" ? "Enter a number" : DialState.number;
                color: DialState.number == "" ? Theme.text-dim : Theme.text;
                font-size: DialState.number == "" ? 18 * Theme.dp : DialState.number.character-count > 14 ? 24 * Theme.dp : 30 * Theme.dp;
                letter-spacing: DialState.number == "" ? 0 : 1 * Theme.dp;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 48 * Theme.dp;
                Rectangle {
                    width: 40 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: bs.pressed && DialState.number != "" ? Theme.pressed : transparent;
                }

                Glyph {
                    source: @image-url("@neoui/icons/sys/backspace.svg");
                    size: 24 * Theme.dp;
                    colorize: DialState.number == "" ? Theme.text-dim : Theme.text;
                }

                property <bool> fired;
                bs := TouchArea {
                    enabled: DialState.number != "";
                    changed pressed => {
                        if self.pressed {
                            parent.fired = false;
                        }
                    }
                    clicked => {
                        if !parent.fired {
                            DialState.act("backspace", "");
                        }
                    }
                }

                Timer {
                    interval: 500ms;
                    running: bs.pressed && !parent.fired;
                    triggered => {
                        parent.fired = true;
                        DialState.act("clear", "");
                    }
                }
            }
        }

        Keypad {
            typed(k) => {
                DialState.act("key", k);
            }
            held(k) => {
                DialState.act("key-long", k);
            }
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                width: 64 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: call.pressed ? #1e9e5d : #28b46d;
                Glyph {
                    source: @image-url("@neoui/icons/sys/call.svg");
                    size: 28 * Theme.dp;
                    colorize: white;
                }

                call := TouchArea {
                    clicked => {
                        DialState.act("call", "");
                    }
                }
            }
        }
    }
}

// The root: Recents, the Fab, and the keypad sheet over it when the view is "dial".
component Recents inherits Rectangle {
    RecentsList {
        height: parent.height;
    }

    if Nav.view == "" && !DialState.selecting: Fab {
        x: parent.width - self.width - 16 * Theme.dp;
        y: parent.height - self.height - 16 * Theme.dp;
        icon: @image-url("@neoui/icons/sys/keypad.svg");
        label: "Open keypad";
        clicked => {
            DialState.act("keypad", "");
        }
    }
    if Nav.view == "dial": KeypadSheet {
        y: parent.height - self.height;
    }
}

// A details action row (Open contact, Block number, Delete from log): a 44 dp glyph slot and the text.
component ActionRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger;
    callback clicked;
    height: Theme.list-row-h;
    background: t.pressed ? Theme.pressed : transparent;
    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 16 * Theme.dp;
        padding-right: 16 * Theme.dp;
        spacing: 14 * Theme.dp;
        HorizontalLayout {
            width: 44 * Theme.dp;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Glyph {
                    source: root.icon;
                    size: 22 * Theme.dp;
                    colorize: root.danger ? Theme.danger : Theme.text-secondary;
                }
            }
        }

        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Call details (p2-phone-details): the avatar, number and type, Call and Message, the calls, the actions.
component Details inherits NeoList {
    VerticalLayout {
        alignment: start;
        VerticalLayout {
            padding-top: 20 * Theme.dp;
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-bottom: 18 * Theme.dp;
            spacing: 10 * Theme.dp;
            HorizontalLayout {
                alignment: center;
                Face {
                    size: 88 * Theme.dp;
                    initials: DialState.detail-initials;
                    tint: DialState.detail-tint;
                    glyph: DialState.detail-private ? 1 : 0;
                }
            }

            if DialState.detail-number != "": Text {
                text: DialState.detail-number;
                color: Theme.text-secondary;
                font-size: 16 * Theme.dp;
                horizontal-alignment: center;
            }
            if DialState.detail-can-call: HorizontalLayout {
                padding-top: 8 * Theme.dp;
                spacing: 12 * Theme.dp;
                Pill {
                    horizontal-stretch: 1;
                    text: "Call";
                    green: true;
                    icon: @image-url("@neoui/icons/sys/call.svg");
                    clicked => {
                        DialState.act("detail-call", "");
                    }
                }

                Pill {
                    horizontal-stretch: 1;
                    text: "Message";
                    icon: @image-url("@neoui/icons/sys/message.svg");
                    clicked => {
                        DialState.act("detail-message", "");
                    }
                }
            }
        }

        SectionHeader {
            text: "Calls";
        }

        for c[i] in DialState.detail-calls: Rectangle {
            height: Theme.list-row-h;
            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                spacing: 14 * Theme.dp;
                HorizontalLayout {
                    width: 44 * Theme.dp;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Direction {
                            kind: c.kind;
                            size: 20 * Theme.dp;
                        }
                    }
                }

                Text {
                    text: c.kind == 1 ? "Dialled" : c.kind == 2 ? "Received" : c.kind == 4 ? "Rejected" : c.kind == 5 ? "Blocked" : "Missed";
                    color: c.kind == 3 ? Theme.danger : Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: c.when + (c.duration != "" ? " · " + c.duration : "");
                    color: Theme.text-secondary;
                    font-size: Theme.font-label;
                    vertical-alignment: center;
                }
            }

            Hairline {
                left: 74 * Theme.dp;
            }
        }
        Rectangle {
            height: 8 * Theme.dp;
        }

        if DialState.detail-can-call: ActionRow {
            text: DialState.detail-known ? "Open contact" : "Add to contacts";
            icon: DialState.detail-known ? @image-url("@neoui/icons/sys/contacts.svg") : @image-url("@neoui/icons/sys/person_add.svg");
            clicked => {
                DialState.act("detail-contact", "");
            }
        }
        if DialState.detail-can-call: ActionRow {
            text: DialState.detail-blocked ? "Unblock number" : "Block number";
            icon: @image-url("@phone-shared/icons/block.svg");
            clicked => {
                DialState.act("detail-block", "");
            }
        }
        ActionRow {
            text: "Delete from log";
            icon: @image-url("@neoui/icons/sys/delete.svg");
            danger: true;
            clicked => {
                DialState.act("detail-delete", "");
            }
        }
    }
}

// Speed dial (p2-phone-speed): keys 1-9 as tiles, 1 the voice mailbox; an empty key is dashed (Assign).
component SpeedDial inherits NeoList {
    property <length> gap: 8 * Theme.dp;
    property <length> side: (self.width - 32 * Theme.dp - 2 * gap) / 3;
    VerticalLayout {
        alignment: start;
        Rectangle {
            height: 32 * Theme.dp + 3 * 112 * Theme.dp + 2 * root.gap;
            for t[i] in DialState.speed: Rectangle {
                property <bool> empty: t.key != 1 && t.name == "";
                x: 16 * Theme.dp + Math.mod(i, 3) * (root.side + root.gap);
                y: 16 * Theme.dp + Math.floor(i / 3) * (112 * Theme.dp + root.gap);
                width: root.side;
                height: 112 * Theme.dp;
                border-radius: 14 * Theme.dp;
                background: ta.pressed ? Theme.pressed : self.empty ? transparent : Theme.card;
                border-width: self.empty ? 0 : max(1px, Theme.dp / 2);
                border-color: Theme.card-border;
                if empty: Dashed { }
                Text {
                    x: 10 * Theme.dp;
                    y: 8 * Theme.dp;
                    text: t.key;
                    color: Theme.text-dim;
                    font-size: 13 * Theme.dp;
                    font-weight: 600;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 8 * Theme.dp;
                    HorizontalLayout {
                        alignment: center;
                        if t.key == 1: Rectangle {
                            width: 44 * Theme.dp;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: #2b3038;
                            Glyph {
                                source: @image-url("@neoui/icons/sys/voicemail.svg");
                                size: 22 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }
                        if t.key != 1 && t.name != "": Face {
                            initials: t.initials;
                            tint: t.tint;
                        }
                        if empty: Rectangle {
                            width: 44 * Theme.dp;
                            height: self.width;
                            Glyph {
                                source: @image-url("@neoui/icons/sys/add.svg");
                                size: 24 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }
                    }

                    Text {
                        text: t.key == 1 ? "Voicemail" : empty ? "Assign" : t.name;
                        color: empty ? Theme.text-secondary : Theme.text;
                        font-size: Theme.font-label;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                ta := TouchArea {
                    clicked => {
                        DialState.act("speed", t.key);
                    }
                }
            }
        }

        Text {
            text: "Hold a digit in the dialer to call.";
            color: Theme.text-secondary;
            font-size: Theme.font-label;
            horizontal-alignment: center;
        }
    }
}

// The contacts' numbers to put on a key (p2-phone-speed-pick: the kit sheet, a row per number).
// Made open (the kit Sheet keeps its own `open`): the app's state shows and hides it, and Back closes it there.
component PickSheet inherits Sheet {
    open: true;
    dismissed => {
        DialState.act("pick-dismiss", "");
    }
    Heading {
        text: DialState.pick-heading;
        left: 16 * Theme.dp;
        padding-top: 0;
        padding-bottom: 0;
        height: 44 * Theme.dp;
    }

    // the sheet grows with its rows, up to most of the page; then they scroll
    NeoList {
        height: min(DialState.pick.length, 6) * 64 * Theme.dp + (DialState.pick.length == 0 ? 64 * Theme.dp : 0);
        VerticalLayout {
            alignment: start;
            for p[i] in DialState.pick: Rectangle {
                height: 64 * Theme.dp;
                background: pt.pressed ? Theme.pressed : transparent;
                HorizontalLayout {
                    padding-left: 16 * Theme.dp;
                    padding-right: 16 * Theme.dp;
                    spacing: 14 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        Face {
                            size: 40 * Theme.dp;
                            initials: p.initials;
                            tint: p.tint;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3 * Theme.dp;
                        horizontal-stretch: 1;
                        Text {
                            text: p.title;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 500;
                            overflow: elide;
                        }

                        Text {
                            text: p.number;
                            color: Theme.text-secondary;
                            font-size: Theme.font-label;
                            overflow: elide;
                        }
                    }
                }

                Hairline {
                    left: 70 * Theme.dp;
                }

                pt := TouchArea {
                    clicked => {
                        DialState.act("pick", i);
                    }
                }
            }
            if DialState.pick.length == 0: Text {
                height: 64 * Theme.dp;
                text: "No contacts with numbers";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// An assigned key: change its contact or clear it.
component KeySheet inherits Sheet {
    open: true;
    dismissed => {
        DialState.act("key-dismiss", "");
    }
    Heading {
        text: DialState.pick-heading;
    }

    ListRow {
        title: "Change";
        has-icon: true;
        icon: @image-url("@neoui/icons/sys/edit.svg");
        icon-tint: Theme.text-secondary;
        clicked => {
            DialState.act("key-change", "");
        }
    }

    ListRow {
        title: "Remove";
        has-icon: true;
        icon: @image-url("@neoui/icons/sys/delete.svg");
        icon-tint: Theme.danger;
        divider: false;
        clicked => {
            DialState.act("key-remove", "");
        }
    }
}

export component PhonePage inherits Rectangle {
    // bakes the keyboard languages' letters into the binary: names come in any of them
    Alphabets { }

    if Nav.view == "" || Nav.view == "dial": Recents { }
    if Nav.view == "detail": Details { }
    if Nav.view == "speed": SpeedDial { }
    if Nav.view == "speed" && DialState.pick-open: PickSheet { }
    if Nav.view == "speed" && DialState.key-open: KeySheet { }
}
