// SPDX-License-Identifier: GPL-3.0-only
// Contacts (mockups 16-26): the list with search, favourites, per-script sections and the side index ("" and
// "mark"); the card ("card"); the editor ("edit"); the queries over them.
import { Theme } from "@neoui/theme.slint";
import { NeoList } from "@neoui/components/scroll.slint";
import { Alphabets } from "@neoui/components/keyboard/glyphs.slint";
import { Nav } from "../nav.slint";
import { Avatar, Band, Glyph, Query, RowAction, Sheet } from "../common.slint";
import { ContactsState } from "state.slint";
import { BlockedBanner, Field, HitRow, InfoRow, LabelChip, Minus, PersonRow, SideIndex } from "parts.slint";

component ListView inherits VerticalLayout {
    property <bool> marking: Nav.view == "mark";
    if !marking: Rectangle {
        height: 64 * Theme.dp;
        Field {
            x: 14 * Theme.dp;
            width: parent.width - 28 * Theme.dp;
            search: true;
            clearable: true;
            placeholder: "Search " + ContactsState.total + " contacts";
            text <=> ContactsState.search;
            edited(t) => {
                ContactsState.act("search", t);
            }
        }
    }
    if ContactsState.search != "" && !marking: VerticalLayout {
        vertical-stretch: 1;
        Band {
            text: ContactsState.results.length == 1 ? "1 RESULT" : ContactsState.results.length + " RESULTS";
        }

        NeoList {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for h[i] in ContactsState.results: HitRow {
                    initials: h.initials;
                    tint: h.tint;
                    name: [h.name-pre, h.name-hit, h.name-post];
                    detail: [h.detail-pre, h.detail-hit, h.detail-post];
                    divider: i > 0;
                    clicked => {
                        ContactsState.act("open", h.id);
                    }
                }
            }
        }
    }
    if ContactsState.search == "" || marking: Rectangle {
        vertical-stretch: 1;
        property <length> index-w: index-on ? 22 * Theme.dp : 0;
        property <bool> index-on: !marking && ContactsState.index.length > 0;
        list := NeoList {
            content := VerticalLayout {
                alignment: start;
                if !marking: Rectangle {
                    height: 52 * Theme.dp;
                    background: mt.pressed ? Theme.pressed : transparent;
                    HorizontalLayout {
                        padding-left: 14 * Theme.dp;
                        padding-right: 14 * Theme.dp;
                        spacing: 12 * Theme.dp;
                        Rectangle {
                            width: 34 * Theme.dp;
                            height: self.width;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            background: #2b3038;
                            Glyph {
                                source: @image-url("../icons/person.svg");
                                size: 18 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }

                        Text {
                            text: "My card";
                            color: Theme.text;
                            font-size: 16 * Theme.dp;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Glyph {
                            source: @image-url("@neoui/icons/sys/chevron_right.svg");
                            size: 24 * Theme.dp;
                            colorize: Theme.text-dim;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    mt := TouchArea {
                        clicked => {
                            ContactsState.act("open", -1);
                        }
                    }
                }
                if !marking && ContactsState.favourites.length > 0: Band {
                    text: "FAVOURITES";
                }
                if !marking && ContactsState.favourites.length > 0: Flickable {
                    height: 94 * Theme.dp;
                    content-width: max(self.width, favs.preferred-width);
                    favs := HorizontalLayout {
                        padding: 12 * Theme.dp;
                        padding-left: 14 * Theme.dp;
                        padding-right: 14 * Theme.dp;
                        spacing: 16 * Theme.dp;
                        alignment: start;
                        for f in ContactsState.favourites: Rectangle {
                            VerticalLayout {
                                spacing: 5 * Theme.dp;
                                HorizontalLayout {
                                    alignment: center;
                                    Avatar {
                                        initials: f.initials;
                                        tint: f.tint;
                                        size: 52 * Theme.dp;
                                    }
                                }

                                Text {
                                    text: f.name;
                                    font-family: "DejaVu Sans";
                                    color: Theme.text;
                                    font-size: 12.5 * Theme.dp;
                                    horizontal-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    ContactsState.act("open", f.id);
                                }
                            }
                        }
                    }
                }
                if ContactsState.total == 0: HorizontalLayout {
                    padding-left: 24 * Theme.dp;
                    padding-right: 24 * Theme.dp;
                    Text {
                        height: 140 * Theme.dp;
                        text: "No contacts yet\nTap New, or import vCards from Options";
                        color: Theme.text-dim;
                        font-size: 15 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                // the sections, beside the side index
                secs := VerticalLayout {
                    padding-right: index-w;
                    for s in ContactsState.sections: VerticalLayout {
                        Band {
                            text: s.letter;
                            font-family: "DejaVu Sans";
                        }

                        for p[j] in s.people: PersonRow {
                            name: p.name;
                            initials: p.initials;
                            tint: p.tint;
                            divider: j > 0;
                            marking: marking;
                            marked: p.marked;
                            clicked => {
                                ContactsState.act(marking ? "mark" : "open", p.id);
                            }
                        }
                    }
                }
            }
        }

        // the index starts beside the first section and stays on screen once the list scrolls past my card
        if index-on: SideIndex {
            x: parent.width - index-w;
            y: max(0px, list.content-y + secs.y);
            width: index-w;
            height: parent.height - self.y;
            marks: ContactsState.index;
            jump(top) => {
                list.content-y = min(0px, max(list.height - list.content-height, -(secs.y + top * Theme.dp)));
            }
        }
    }
}

component CardView inherits VerticalLayout {
    NeoList {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            Rectangle {
                background: ContactsState.card-blocked != "" ? @linear-gradient(180deg, #1d1013 0%, #000000 100%) : @linear-gradient(180deg, #0f1622 0%, #000000 100%);
                VerticalLayout {
                    padding-top: 18 * Theme.dp;
                    padding-bottom: ContactsState.card-blocked != "" ? 14 * Theme.dp : 16 * Theme.dp;
                    spacing: 4 * Theme.dp;
                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            initials: ContactsState.card-initials;
                            tint: ContactsState.card-tint;
                            size: Theme.avatar-large;
                        }
                    }

                    // the name, and beside it the favourite star (no header: the status bar has the title)
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6 * Theme.dp;
                        padding-left: 14 * Theme.dp;
                        padding-right: 14 * Theme.dp;
                        Text {
                            text: ContactsState.card-name;
                            font-family: "DejaVu Sans";
                            color: Theme.text;
                            font-size: 24 * Theme.dp;
                            font-weight: 600;
                            overflow: elide;
                            height: self.preferred-height + 10 * Theme.dp;
                            vertical-alignment: bottom;
                        }

                        if !ContactsState.card-mine: Rectangle {
                            width: 36 * Theme.dp;
                            Glyph {
                                y: parent.height - self.height - 2 * Theme.dp;
                                source: ContactsState.card-favourite ? @image-url("../icons/star_full.svg") : @image-url("@neoui/icons/sys/star.svg");
                                size: 24 * Theme.dp;
                                colorize: ContactsState.card-favourite ? Theme.warn : Theme.text-secondary;
                            }

                            TouchArea {
                                clicked => {
                                    ContactsState.act("favourite", "");
                                }
                            }
                        }
                    }

                    if ContactsState.card-company != "": Text {
                        text: ContactsState.card-company;
                        font-family: "DejaVu Sans";
                        color: Theme.text-secondary;
                        font-size: 14.5 * Theme.dp;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if ContactsState.card-blocked != "": HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                padding-bottom: 8 * Theme.dp;
                BlockedBanner {
                    detail: ContactsState.card-blocked;
                    unblock => {
                        ContactsState.act("unblock", "");
                    }
                }
            }
            for n[i] in ContactsState.card-numbers: InfoRow {
                label: n.label;
                value: n.number;
                divider: i > 0;
                HorizontalLayout {
                    spacing: 12 * Theme.dp;
                    alignment: center;
                    RowAction {
                        y: (parent.height - self.height) / 2;
                        visible: ContactsState.can-message;
                        icon: @image-url("../icons/message.svg");
                        tint: Theme.accent;
                        clicked => {
                            ContactsState.act("message", n.number);
                        }
                    }

                    RowAction {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("@neoui/icons/sys/call.svg");
                        clicked => {
                            ContactsState.act("call", n.number);
                        }
                    }
                }
            }
            if ContactsState.card-email != "": InfoRow {
                label: "Email";
                value: ContactsState.card-email;
                size: 16 * Theme.dp;
                divider: ContactsState.card-numbers.length > 0;
                RowAction {
                    y: (parent.height - self.height) / 2;
                    visible: ContactsState.can-email;
                    icon: @image-url("../icons/mail.svg");
                    tint: Theme.accent;
                    clicked => {
                        ContactsState.act("email", "");
                    }
                }
            }
            if ContactsState.card-note != "": InfoRow {
                label: "Note";
                value: ContactsState.card-note;
                size: 15 * Theme.dp;
                wrap: true;
                divider: true;
            }
            if ContactsState.card-speed > 0: InfoRow {
                label: "Speed dial";
                value: "Key " + ContactsState.card-speed;
                size: 15 * Theme.dp;
                divider: true;
            }
        }
    }
}

component EditView inherits VerticalLayout {
    NeoList {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                padding: 14 * Theme.dp;
                spacing: 12 * Theme.dp;
                // photos come later: the slot shows, disabled
                Rectangle {
                    width: 84 * Theme.dp;
                    height: 84 * Theme.dp;
                    y: 4 * Theme.dp;
                    Glyph {
                        source: @image-url("../icons/photo_slot.svg");
                        size: 84 * Theme.dp;
                        colorize: #ffffff4d;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2 * Theme.dp;
                        HorizontalLayout {
                            alignment: center;
                            Glyph {
                                source: @image-url("@neoui/icons/sys/add.svg");
                                size: 24 * Theme.dp;
                                colorize: Theme.text-dim;
                            }
                        }

                        Text {
                            text: "Photo";
                            color: Theme.text-dim;
                            font-size: 11.5 * Theme.dp;
                            horizontal-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8 * Theme.dp;
                    Field {
                        placeholder: "First name";
                        text <=> ContactsState.edit-first;
                    }

                    Field {
                        placeholder: "Last name";
                        text <=> ContactsState.edit-last;
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                padding-bottom: 12 * Theme.dp;
                Field {
                    placeholder: "Company";
                    text <=> ContactsState.edit-company;
                }
            }

            Band {
                text: "NUMBERS";
            }

            VerticalLayout {
                padding: 12 * Theme.dp;
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 8 * Theme.dp;
                for n[i] in ContactsState.edit-numbers: HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    LabelChip {
                        text: ContactsState.short-labels[n.kind];
                        clicked => {
                            ContactsState.act("label", i);
                        }
                    }

                    Field {
                        placeholder: "Number";
                        keys: 4;
                        text <=> n.number;
                    }

                    Minus {
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            ContactsState.act("remove-number", i);
                        }
                    }
                }
                if ContactsState.edit-numbers.length < 4: Rectangle {
                    height: 34 * Theme.dp;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6 * Theme.dp;
                        Glyph {
                            source: @image-url("@neoui/icons/sys/add.svg");
                            size: 18 * Theme.dp;
                            colorize: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Add number";
                            color: Theme.accent;
                            font-size: 15 * Theme.dp;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            ContactsState.act("add-number", "");
                        }
                    }
                }
            }

            Band {
                text: "MORE";
            }

            VerticalLayout {
                padding: 12 * Theme.dp;
                padding-left: 14 * Theme.dp;
                padding-right: 14 * Theme.dp;
                spacing: 8 * Theme.dp;
                Field {
                    placeholder: "Email";
                    text <=> ContactsState.edit-email;
                }

                Field {
                    placeholder: "Note";
                    text <=> ContactsState.edit-note;
                }
            }
        }
    }
}

export component ContactsPage inherits Rectangle {
    // names come in any keyboard language, and from vCards with accents: their glyphs must be baked in
    Alphabets { }
    Text {
        visible: false;
        font-family: "DejaVu Sans";
        text: "•–·▸ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿĄąĆćČčĘęĞğİıŁłŃńŇňŐőŒœŘřŚśŞşŠšŢţŰűŸŹźŻżŽž";
    }

    if Nav.view == "" || Nav.view == "mark": ListView { }
    if Nav.view == "card": CardView { }
    if Nav.view == "edit": EditView { }
    if Nav.view == "edit": Sheet {
        heading: "Number type";
        items: ContactsState.labels;
        open: ContactsState.picking >= 0;
        marked: ContactsState.picking >= 0 ? ContactsState.edit-numbers[ContactsState.picking].kind : -1;
        dismissed => {
            ContactsState.act("pick-cancel", "");
        }
        selected(i, item) => {
            ContactsState.act("pick", i);
        }
    }
    Query {
        open: ContactsState.dialog-open;
        question: ContactsState.dialog-question;
        detail: ContactsState.dialog-detail;
        confirm: ContactsState.dialog-confirm;
        danger: true;
        checks: ContactsState.dialog-checks;
        checked: ContactsState.dialog-checked;
        confirmed => {
            ContactsState.act("confirm", "");
        }
        cancelled => {
            ContactsState.act("cancel", "");
        }
        toggled(i) => {
            ContactsState.act("check", i);
        }
    }
}
