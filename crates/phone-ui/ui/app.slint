// SPDX-License-Identifier: GPL-3.0-only
// NeoPhone (NEOPHONE.EXE): Phone, Contacts and Messages as one app behind three home icons, plus the call screens and their
// settings. Drawn by its own process into the surface the UI server shows between its status bar and toolbar; the
// title and the toolbar's middle button are the app's (neoui ipc 1.4), set from Rust per page and view.
import "@neoui/fonts/Inter-VariableFont.ttf";
import "@neoui/fonts/DejaVuSans.ttf";
import { Theme } from "@neoui/theme.slint";
import { Scroll } from "@neoui/components/scroll.slint";
import { KeyboardFocus } from "@neoui/components/keyboard/focus.slint";
import { Nav } from "nav.slint";
import { Sheet, Note } from "common.slint";
import { DialState } from "phone/state.slint";
import { PhonePage } from "phone/pages.slint";
import { ContactsState } from "contacts/state.slint";
import { ContactsPage } from "contacts/pages.slint";
import { CallState } from "call/state.slint";
import { CallPage } from "call/pages.slint";
import { SettingsState } from "settings/state.slint";
import { SettingsPage } from "settings/pages.slint";
import { MessagesState } from "messages/state.slint";
import { MessagesPage } from "messages/pages.slint";

export { Theme, Scroll, KeyboardFocus, Nav, DialState, ContactsState, CallState, SettingsState, MessagesState }

export component PhoneApp inherits Window {
    default-font-family: "Inter";
    background: Theme.bg;
    // A tap that no row or button takes lands here, below the pages: the focus moves to `sink`, the field loses it
    // and the keyboard closes. A page or view change does the same (a field removed with its `if` never reports
    // losing focus).
    sink := FocusScope { }
    TouchArea {
        clicked => {
            root.leave-fields();
        }
    }

    property <string> place: Nav.page + "/" + Nav.view;
    changed place => {
        root.leave-fields();
    }

    public function leave-fields() {
        sink.focus();
        KeyboardFocus.open = false;
    }

    if Nav.page == 0: PhonePage { }
    if Nav.page == 1: ContactsPage { }
    if Nav.page == 3: CallPage { }
    if Nav.page == 4: SettingsPage { }
    if Nav.page == 6: MessagesPage { }
    Sheet {
        items: Nav.options;
        open: Nav.options-open;
        dismissed => {
            Nav.act("dismiss-options", "");
        }
        selected(i, item) => {
            Nav.act("option", item);
        }
    }

    Note {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16 * Theme.dp;
        text: Nav.note;
    }
}
